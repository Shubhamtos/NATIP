!reports/probability/frozen_v2_buy_rules.json
!reports/probability/frozen_tuned_binary77_confidence_config.json
!reports/probability/frozen_tuned_binary77_confidence_rules.json
!outputs/
outputs/*
!outputs/.gitkeep

# Never commit local Streamlit secrets.
.streamlit/secrets.toml
