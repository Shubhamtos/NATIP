NATIP_ENVIRONMENT=development
NATIP_APP_NAME=NATIP
NATIP_DATABASE_URL=sqlite:///./natip.db
NATIP_LOG_LEVEL=INFO
NATIP_DEBUG=false
# Set via a local .env or environment variable. Do not commit real secrets.
NATIP_SECRET_KEY=
NATIP_ZERODHA_API_KEY=
NATIP_ZERODHA_API_SECRET=
NATIP_ZERODHA_TOKEN_STORE_PATH=.natip/zerodha_tokens.json
NATIP_YAHOO_DEFAULT_EXCHANGE_SUFFIX=.NS
NATIP_GEMINI_API_KEY=
NATIP_GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
NATIP_OPENAI_MODEL=gpt-4.1-mini
NATIP_ASTRO_ENABLED=false
NATIP_ASTRO_SHADOW_ONLY=true
NATIP_ASTRO_MAX_SCORE_ADJUSTMENT=0
NATIP_ASTRO_EPHEMERIS_PATH=data/astro/de421.bsp
NATIP_ANALYSIS_TOTAL_CAPITAL=
NATIP_ANALYSIS_RISK_PER_TRADE_PCT=1.0
NATIP_ANALYSIS_MAX_POSITION_PCT=5.0
NATIP_ANALYSIS_MAX_SECTOR_EXPOSURE_PCT=25.0
NATIP_ANALYSIS_MAX_NEW_BUYS_PER_DAY=3
NATIP_DECISION_LOG_PATH=data/decisions/decisions.sqlite3
